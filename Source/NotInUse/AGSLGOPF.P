/* Procedyre for utskrift av oppf. liste for aggregater - selger/uke */

    DEFINE VAR fomUkeParam AS INTEGER INITIAL 0.
    DEFINE VAR tomUkeParam AS INTEGER INITIAL 0.
    DEFINE VAR maanedParam AS INTEGER INITIAL 0.
    DEFINE VAR aarParam AS INTEGER.
    DEFINE VAR selgerParam AS CHAR INITIAL "True".
    DEFINE VAR filterUttrykk AS CHAR INITIAL "".
    
    aarParam = YEAR(TODAY).

    RUN SHOPFPRM.W PERSISTENT (INPUT-OUTPUT fomUkeParam,  INPUT-OUTPUT tomUkeParam, 
                INPUT-OUTPUT  maanedParam, INPUT-OUTPUT selgerParam, INPUT-OUTPUT aarParam).

    /* Hvis ukeParam = -1, er cancel trykket */
    IF fomUkeParam = -1 THEN
        RETURN.
        
    /* Bygg opp SQL */
    filterUttrykk = "NPAGANLG.aktivt = TRUE  ".

    IF fomUkeParam > 0 THEN 
        /* Hvis denne er 0, skal den ikke tas med, da skal alle uker  < current uke skrives */
        filterUttrykk = filterUttrykk +  " AND NPAGTOPP.neste_oppf_uke >= " + string(fomUkeParam).

    IF tomUkeParam > 0 THEN 
        /* Hvis denne er 0, skal den ikke tas med, da skal alle uker  > current uke skrives */
        filterUttrykk = filterUttrykk +  " AND NPAGTOPP.neste_oppf_uke <= " + string(tomUkeParam).

    IF aarParam > 0 THEN
        filterUttrykk = filterUttrykk + " AND NPAGTOPP.neste_oppf_aar = " + string(aarParam).
    IF selgerParam = ? THEN
        filterUttrykk = filterUttrykk + " AND NOT NPAGTOPP.oppf_status BEGINS 'Tapt'  
                        AND NOT NPAGTOPP.oppf_status = 'Ukjent' 
                        AND NOT NPAGTOPP.oppf_status = 'ORDRE'".
    ELSE
        filterUttrykk = filterUttrykk + " AND  NPAGANLG.selger = '" + selgerParam + "'
                      AND (NOT NPAGTOPP.oppf_status BEGINS 'Tapt' 
                      AND NOT NPAGTOPP.oppf_status = 'ORDRE')".

     RUN aderb/_prntrb2.p
                    ("report\noragg.prl",
                    "Aggregat - oppf - uke selger",
                    "-db norcalc -H 10.11.0.22 -S 4000 -U norcalc -P norcalc123",              
                    "O", 
                    filterUttrykk,
                    "",
                    "",
                    "",
                    "",
                    "",
                    0,
                    0,
                    0,
                    no,
                    "Aggregatttilbud - oppfølging for uke",
                    yes,
                    yes,
                    no,
                    "",
                    "status.out").        
