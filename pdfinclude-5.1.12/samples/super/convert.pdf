stream
BT
1 0 0 1 10 562 Tm
/BF1 10 Tf
0 0 0 rg
(  &IF NOT PROVERSION BEGINS "8" &THEN) Tj
0 -10 TD
(    &IF "{1}" = "THIS-PROCEDURE" &THEN) Tj
0 -10 TD
(      IF VALID-HANDLE\(THIS-PROCEDURE\) THEN THIS-PROCEDURE:ADD-SUPER-PROCEDURE\(h_PDFinc\).) Tj
0 -10 TD
(    &ELSEIF "{1}" = "" &THEN) Tj
0 -10 TD
(      IF VALID-HANDLE\(SESSION\) THEN SESSION:ADD-SUPER-PROCEDURE\(h_PDFinc\).) Tj
0 -10 TD
(    &ENDIF) Tj
0 -10 TD
(  &ENDIF) Tj
0 -20 TD
(END. /* If Not a valid Handle to PDFinclude */) Tj
0 -10 TD
(ELSE DO:) Tj
0 -10 TD
