stream
BT
1 0 0 1 10 552 Tm
/BF1 10 Tf
0 0 0 rg
(  07/06/05    G Campbell    removed h_PDFinc variable -- added into pdfglobal.i) Tj
0 -20 TD
(  08/15/12    JC Cardot     add parameter {2} to specify a "version" of pdf_inc.p) Tj
0 -10 TD
(                            to test with) Tj
0 -20 TD
(  05/11/14    JC Cardot     if we found pdfinc but it is not a super proc of the session,) Tj
0 -10 TD
(                            or this-procedure, then add it ; see samples/super/layer.p) Tj
0 -10 TD
(                            This allows to use the same pdf_inc.p instance in many .p procedures.) Tj
0 -10 TD
(                            The first to be run must use the "THIS-PROCEDURE" argument of pdf_inc.i) Tj
0 -10 TD
(                            while these others must use no argument.) Tj
0 -20 TD
(  10/16/14    JC Cardot     move old versions of pdfinc.p in the old/ subdirectory) Tj
0 -20 TD
(  03/26/15    JC Cardot     move pdfglobal.i to inc) Tj
0 -20 TD
(******************************************************************************/) Tj
0 -20 TD
({ inc/pdfglobal.i "NEW SHARED"}) Tj
0 -20 TD
(/* PEKI - Find the handle if on the air */) Tj
0 -10 TD
(&IF "{1}" = "THIS-PROCEDURE" &THEN) Tj
0 -10 TD
(    /* h_PDFinc = THIS-PROCEDURE. */ /* 13-MAY-2014 jcc: does not work, will not find any running pdf include procedure. We have to use SESSION:FIRST-PROCEDURE. */) Tj
0 -10 TD
(     h_PDFinc = SESSION:FIRST-PROCEDURE.) Tj
0 -20 TD
(    DO WHILE VALID-HANDLE\(h_PDFinc\)) Tj
0 -10 TD
(    AND h_PDFinc:PRIVATE-DATA <> 'Persistent PDFinc':) Tj
0 -10 TD
(       h_PDFinc = h_PDFinc:NEXT-SIBLING.) Tj
0 -10 TD
(    END.) Tj
0 -20 TD
(&ELSEIF "{1}" = "" &THEN) Tj
0 -10 TD
(     h_PDFinc = SESSION:FIRST-PROCEDURE.) Tj
0 -20 TD
(     DO WHILE VALID-HANDLE\(h_PDFinc\)) Tj
0 -10 TD
(     AND h_PDFinc:PRIVATE-DATA <> 'Persistent PDFinc':) Tj
0 -10 TD
(         h_PDFinc = h_PDFinc:NEXT-SIBLING.) Tj
0 -10 TD
(     END.) Tj
0 -10 TD
(&ENDIF) Tj
0 -20 TD
(IF NOT VALID-HANDLE\(h_PDFinc\) THEN DO:) Tj
0 -20 TD
(  /* Call pdf_inc.p Persistenly */) Tj
0 -10 TD
(  &IF "{2}" = "" &THEN) Tj
0 -10 TD
(  RUN {&PDFDIR}pdf_inc.p PERSISTENT ) Tj
0 -10 TD
(                SET h_PDFinc.) Tj
0 -10 TD
(  &ELSE) Tj
0 -10 TD
(  RUN {&PDFDIR}old/pdf_inc.{2}.p PERSISTENT ) Tj
0 -10 TD
(                SET h_PDFinc.) Tj
0 -10 TD
(  &ENDIF) Tj
0 -20 TD
(  ASSIGN h_PDFinc:PRIVATE-DATA = 'Persistent PDFinc'.) Tj
ET
endstream
endobj
