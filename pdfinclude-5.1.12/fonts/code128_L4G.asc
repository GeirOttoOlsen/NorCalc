/*******************************************************

    Cb128.i
    
    Rìle:        Convertit une chaåne pour affichage avec Police CODE128.TTF
    Utilisation: Inclure dans le programme et appeler la fonction Cb128().
    Note:        Si des caractäres invalides sont rencontrÇs, renvoie un chaine vide.
    Exemple:     Voir procedure WPrintCb128
        
********************************************************/

/* Fonction interne appellÇe par la fonction Cb128 */
FUNCTION Cb128TestSum RETURNS INTEGER (pi_i AS INT, pi_min AS INT, pi_chaine AS CHAR):
    /*  si les vi_min caractäres Ö partir de vi_i sont numÇriques, alors vi_min=0 */
    ASSIGN pi_min = pi_min - 1.
    IF pi_i + pi_min <= LENGTH(pi_chaine) THEN DO WHILE pi_min >= 0:
        IF ASC(SUBSTRING(pi_chaine, pi_i + pi_min, 1)) < 48 OR
           ASC(SUBSTRING(pi_chaine, pi_i + pi_min, 1)) > 57 THEN DO:
            RETURN pi_min.
        END.
        ELSE DO:
            ASSIGN pi_min = pi_min - 1.
        END.
    END.
    RETURN pi_min.
END.

/* Fonction Ö appeler */
FUNCTION Cb128 RETURNS CHAR (pi_chaine AS CHAR):

  DEF VAR vi_i        AS INT  NO-UNDO.
  DEF VAR vi_min      AS INT  NO-UNDO.
  DEF VAR vi_dummy    AS INT  NO-UNDO.
  DEF VAR vi_checksum AS INT  NO-UNDO.
  DEF VAR vl_TableB   AS LOG  NO-UNDO INIT TRUE.
  DEF VAR vc_Cb128    AS CHAR NO-UNDO.

  IF LENGTH(pi_chaine) > 0 THEN DO:
  
      /* VÇrifier si caractäres valides */
      DO vi_i = 1 TO LENGTH(pi_chaine):
          IF ASC(SUBSTRING(pi_chaine, vi_i, 1)) < 32 OR
             ASC(SUBSTRING(pi_chaine, vi_i, 1)) > 126 THEN DO:
                RETURN "".
          END.
      END.

        
      /* Calculer la chaine de code en optimisant l'usage des tables B et C */
      ASSIGN vi_i = 1.
      DO WHILE vi_i <= LENGTH(pi_chaine):
          /* Voir si intÇressant de passer en table C
             Oui pour 4 chiffres au dÇbut ou Ö la fin, sinon pour 6 chiffres */          
          IF vl_TableB THEN DO:
             ASSIGN vi_min = IF (vi_i = 1 OR vi_i + 3 = LENGTH(pi_chaine)) THEN 4 ELSE 6.
             ASSIGN vi_min = Cb128TestSum(vi_i, vi_min, pi_chaine).
             IF vi_min < 0 THEN DO:
                IF vi_i = 1 THEN DO: /* DÇbuter sur table C */
                    ASSIGN vc_Cb128 = CHR(210).
                END.
                ELSE DO: /* Commuter sur table C */
                    ASSIGN vc_Cb128 = vc_Cb128 + CHR(204).
                END.
                ASSIGN vl_TableB = False.
             END.
             ELSE DO:
                 IF vi_i = 1 THEN DO: /* DÇbuter sur table B */
                     ASSIGN vc_Cb128 = CHR(209).
                 END.
             END.
          END.

          /* On est sur la table C, essayer de traiter 2 chiffres */
          IF NOT vl_TableB THEN DO:
              ASSIGN vi_min = 2.
              ASSIGN vi_min = Cb128TestSum(vi_i, vi_min, pi_chaine).
              IF vi_min < 0 THEN DO: /* OK pour 2 chiffres, les traiter */
                  ASSIGN vi_dummy = INTEGER(SUBSTRING(pi_chaine, vi_i, 2)).
                  ASSIGN vi_dummy = IF vi_dummy < 95 THEN vi_dummy + 32 ELSE vi_dummy + 100.
                  ASSIGN vc_Cb128 = vc_Cb128 + CHR(vi_dummy)
                         vi_i = vi_i + 2.
              END.
              ELSE DO: /* On n'a pas 2 chiffres, repasser en table B */
                  ASSIGN vc_Cb128  = vc_Cb128 + CHR(205)
                         vl_TableB = TRUE.
              END.
          END.

          /* On traite 1 caractäre en table B */
          IF vl_TableB THEN DO: 
            ASSIGN vc_Cb128 = vc_Cb128 + SUBSTRING(pi_chaine, vi_i, 1)
                   vi_i     = vi_i + 1.
          END.
      END. /* DO WHILE  */


      /* Calcul de la clÇ de contrìle */
      DO vi_i = 1 TO LENGTH(vc_Cb128):
          ASSIGN vi_dummy = ASC(SUBSTRING(vc_Cb128, vi_i, 1)).
          ASSIGN vi_dummy = IF vi_dummy < 127 THEN vi_dummy - 32 ELSE vi_dummy - 100.
          IF vi_i = 1 THEN DO:
              ASSIGN vi_Checksum = vi_dummy.
          END.
          ASSIGN vi_checksum = (vi_checksum + (vi_i - 1) * vi_dummy) MODULO 103.
      END.
    
    /* Calcul du code ASCII de la clÇ */
    ASSIGN vi_CheckSum = IF vi_CheckSum < 95 THEN vi_CheckSum + 32 ELSE vi_CheckSum + 100.


    /* Ajout de la clÇ et du STOP */
    ASSIGN vc_Cb128 = vc_Cb128 + CHR(vi_CheckSum) + CHR(211).
  END. /* IF */

  RETURN vc_Cb128.

END FUNCTION.



/*********************************************************
 * Exemple de code pour imprimer un code barre dans Word *
 *********************************************************/
PROCEDURE WPrintCb128 :
    DEF INPUT PARAMETER pi_range AS COM-HANDLE NO-UNDO. /* pi_range est un COM-OBJECT reprÇsentant un zone de texte sous word */
    DEF INPUT PARAMETER pi_val   AS CHAR NO-UNDO.       /* valeur initiale du code barre */

    /* Attention, si pi_range est un texte en fin de paragraphe,
       il peut contenir le caractäre "Fin de paragraphe" ajoutÇ 
       par Word. Celui-ci ne doit pas àtre prÇsent dans le code Ö barres,
       sinon il ne sera pas lisible. Dans ce cas faut ajouter:
       pi_Range:END  = pi_Range:END - 1 avant la ligne
       pi_Range:Font:Name = "Code 128". Ce cas se prÇsente notamment
       lorsqu'on travaille avec des "Text Box".  */


    ASSIGN pi_range:TEXT = Cb128(pi_val)
           pi_Range:Font:Name = "Code 128".

END PROCEDURE.
