ADD TABLE "AdresseListeHode"
  AREA "DataArea2"
  LABEL "Adresseliste hode"
  DUMP-NAME "adressel"
  TABLE-TRIGGER "CREATE" OVERRIDE PROCEDURE "trg/cre_adresselistehode.p" CRC "?" 

ADD FIELD "iAdresseListeHodeId" OF "AdresseListeHode" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Adresselistehode id"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "cAdresseliste" OF "AdresseListeHode" AS character 
  FORMAT "x(50)"
  INITIAL ""
  LABEL "Adresseliste"
  POSITION 3
  MAX-WIDTH 100
  ORDER 20

ADD FIELD "iJBoxCompanyId" OF "AdresseListeHode" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "CompanyId"
  POSITION 4
  MAX-WIDTH 4
  ORDER 30

ADD FIELD "dCreated" OF "AdresseListeHode" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Opprettet"
  POSITION 5
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "cCreatedBy" OF "AdresseListeHode" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Av"
  POSITION 6
  MAX-WIDTH 16
  ORDER 50

ADD FIELD "dModified" OF "AdresseListeHode" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Endret"
  POSITION 7
  MAX-WIDTH 4
  ORDER 60

ADD FIELD "cModifiedBy" OF "AdresseListeHode" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Av"
  POSITION 8
  MAX-WIDTH 16
  ORDER 70

ADD INDEX "idxAdresseListeHod" ON "AdresseListeHode" 
  AREA "IndexArea2"
  UNIQUE
  PRIMARY
  INDEX-FIELD "iAdresseListeHodeId" ASCENDING 

ADD INDEX "idxCompanyId" ON "AdresseListeHode" 
  AREA "IndexArea2"
  INDEX-FIELD "iJBoxCompanyId" ASCENDING 

ADD TABLE "AdresseListeLinje"
  AREA "DataArea2"
  LABEL "Elementer i adresseliste"
  DUMP-NAME "adrliste"
  TABLE-TRIGGER "CREATE" OVERRIDE PROCEDURE "trg/cre_adresselistelinje.p" CRC "?" 

ADD FIELD "iAdresseListeLinjeId" OF "AdresseListeLinje" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Adresseliste linje id"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "iAdresseListeHodeId" OF "AdresseListeLinje" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Adresselistehode id"
  POSITION 3
  MAX-WIDTH 4
  ORDER 20

ADD FIELD "cNavn" OF "AdresseListeLinje" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Navn"
  POSITION 4
  MAX-WIDTH 80
  ORDER 30

ADD FIELD "cPostAdresse" OF "AdresseListeLinje" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Postadresse"
  POSITION 5
  MAX-WIDTH 80
  COLUMN-LABEL ""
  ORDER 40

ADD FIELD "cPostPnr" OF "AdresseListeLinje" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Postnummer"
  POSITION 6
  MAX-WIDTH 16
  ORDER 50

ADD FIELD "cPostSted" OF "AdresseListeLinje" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Poststed"
  POSITION 7
  MAX-WIDTH 80
  ORDER 60

ADD FIELD "cLand" OF "AdresseListeLinje" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Land"
  POSITION 8
  MAX-WIDTH 40
  ORDER 70

ADD FIELD "cEmail" OF "AdresseListeLinje" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Epost"
  POSITION 9
  MAX-WIDTH 80
  ORDER 80

ADD FIELD "cTlf" OF "AdresseListeLinje" AS character 
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Tlf"
  POSITION 10
  MAX-WIDTH 24
