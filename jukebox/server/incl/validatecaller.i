
DEF VAR hAsLib      AS HANDLE NO-UNDO.

hAsLib = DYNAMIC-FUNCTION("startASlib" IN SOURCE-PROCEDURE) NO-ERROR.

IF NOT VALID-HANDLE(hAsLib) THEN DO:
  LOG-MANAGER:WRITE-MESSAGE("Procedure " + THIS-PROCEDURE:FILE-NAME + ": Invalid caller" + IF VALID-HANDLE(SOURCE-PROCEDURE) THEN ": " + SOURCE-PROCEDURE:FILE-NAME ELSE "").
  RETURN.
END.

/* To make the lib available to a sub-procedure: */
FUNCTION startASlib RETURNS HANDLE():
  SOURCE-PROCEDURE:ADD-SUPER-PROCEDURE(hAsLib).
  RETURN hAsLib.
END FUNCTION.
