&ANALYZE-SUSPEND _UIB-CODE-BLOCK _FUNCTION setFldValue C-Win 
FUNCTION setFldValue RETURNS LOGICAL
  ( INPUT icField AS CHAR,INPUT icValue AS CHAR ) :
/*------------------------------------------------------------------------------
  Purpose:  
    Notes:  
------------------------------------------------------------------------------*/
DEF VAR ix AS INT NO-UNDO.
DEF VAR iNumSel AS INT NO-UNDO.

iNumSel = BROWSE brwViperGrpFields:NUM-SELECTED-ROWS.

DO ix = 1 TO iNumSel:
  IF BROWSE brwViperGrpFields:FETCH-SELECTED-ROW(ix) THEN
    BUFFER ttTableFld:BUFFER-FIELD(icField):BUFFER-VALUE = icValue.
END.

BROWSE brwViperGrpFields:REFRESH().

RETURN YES.

END FUNCTION.

