&Scoped-define SELF-NAME tbGrpLabels
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL tbGrpLabels C-Win
ON VALUE-CHANGED OF tbGrpLabels IN FRAME DEFAULT-FRAME /* Labels */
DO:
  DEFINE BUFFER bttViperGrp FOR ttViperGrp.
  DEFINE BUFFER bttTableFld FOR ttTableFld.
  DEFINE VARIABLE rLabels    AS ROWID NO-UNDO.
  DEF VAR iStartSeq         AS INT NO-UNDO.
  rLabels = ROWID(ttViperGrp).

  IF SELF:CHECKED THEN DO:
    IF ttViperGrp.cGroupType = "data" AND ttViperGrp.cLabelGrp = "" THEN DO:
      FOR EACH bttViperGrp BY bttViperGrp.iGroupLabelSeq DESC: iStartSeq = bttViperGrp.iGroupLabelSeq. LEAVE. END.
      CREATE bttViperGrp.
      BUFFER-COPY ttViperGrp TO bttViperGrp.
      ASSIGN bttViperGrp.cViperGrp = ttViperGrp.cViperGrp + "_JBlabels"
             bttViperGrp.cGroupType = "label"
             bttViperGrp.cLabelGrp  = bttViperGrp.cViperGrp
             ttViperGrp.cLabelGrp = bttViperGrp.cViperGrp
             .
      ASSIGN ttViperGrp.iGroupLabelSeq = iStartSeq + 2
             bttViperGrp.iGroupLabelSeq = iStartSeq + 1.

      FOR EACH ttTableFld
          WHERE ttTableFld.cViperGrp = ttViperGrp.cViperGrp:
        CREATE bttTableFld.
        BUFFER-COPY ttTableFld TO bttTableFld.
        ASSIGN bttTableFld.cViperGrp = bttViperGrp.cViperGrp
               bttTableFld.cTtFld    = ttTableFld.cTtFld + "_JBlabel"
               .
      END.

    END.
    SideTopLabels:VISIBLE = ttViperGrp.bHorizontal.
  END.
  ELSE DO:
    FIND FIRST bttViperGrp WHERE bttViperGrp.cViperGrp = ttViperGrp.cLabelGrp
         NO-ERROR.
    IF AVAIL bttViperGrp THEN DO:
      FOR EACH ttTableFld
          WHERE ttTableFld.cViperGrp = bttViperGrp.cViperGrp:
        DELETE ttTableFld.
      END.
      DELETE bttViperGrp.
    END.
    ASSIGN ttViperGrp.cLabelGrp = ""
           ttViperGrp.iGroupLabelSeq = 0
           SideTopLabels:HIDDEN = YES.
  END.

  {&OPEN-QUERY-brwViperGrp} 
  FIND ttViperGrp WHERE ROWID(ttViperGrp) = rLabels.
  BROWSE brwViperGrp:QUERY:REPOSITION-TO-ROWID(rLabels).
  BROWSE brwViperGrp:SELECT-ROW(BROWSE brwViperGrp:FOCUSED-ROW).
  APPLY "value-changed" TO brwViperGrp.
END.

