&Scoped-define SELF-NAME Btn_OK
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL Btn_OK C-Win
ON CHOOSE OF Btn_OK IN FRAME DEFAULT-FRAME /* OK */
DO:
  DEF VAR cView AS CHAR NO-UNDO.
  THIS-PROCEDURE:CURRENT-WINDOW:ALWAYS-ON-TOP = FALSE.
  IF CAN-DO(hParent:INTERNAL-ENTRIES,"genViewDef") AND tbDynQuery:CHECKED THEN DO:
    RUN genViewDef IN hParent(tbPosition:CHECKED,NO,OUTPUT cView,OUTPUT hJboxSuper).
    IF NOT VALID-HANDLE(hJboxSuper) THEN DO:
      MESSAGE "Code replacement tags missing from procedure InitializeObject" SKIP
              "Copy code from preview.."
              VIEW-AS ALERT-BOX INFO BUTTONS OK.  
      ViewText(cView 
             + CHR(10) + CHR(10) + "Query join:" + CHR(10) + ENTRY(1,icParam,CHR(1))
             + CHR(10) + CHR(10) + "Calc.fld proc(s):" + CHR(10) + ENTRY(2,icParam,CHR(1))
              ).
    END.
    ELSE JBoxSession:Instance:setDelayedRun ("assignQueryWrapperInitVals",hJboxSuper).             .
  END.
  ELSE IF tbDynQuery:CHECKED THEN DO:
    FOR EACH ttTableFld WHERE ttTableFld.cDbFld NE ?
        BREAK BY ttTableFld.iTableSeq
              BY ttTableFld.iSeq:
      IF FIRST-OF(ttTableFld.iTableSeq) THEN
        cView = cView + (IF cView NE "" THEN CHR(10) + "   + '," ELSE "     '")
              + ttTableFld.cTable 
              + "'".
      cView = cView + CHR(10)
            + "     + ';"
            + ttTableFld.cDbFld
            + "|" + (IF ttTableFld.cLabel NE ? THEN ttTableFld.cLabel ELSE ttTableFld.cDbFld)
            + (IF ttTableFld.cFormat NE ? THEN "|" +  REPLACE(ttTableFld.cFormat,",","<") ELSE "")
            + "'".
    END.
    ViewText(cView).
  END.

  obOk = YES.
  APPLY "close" TO THIS-PROCEDURE.
END.

