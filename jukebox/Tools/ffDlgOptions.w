&ANALYZE-SUSPEND _UIB-CODE-BLOCK _FUNCTION setGrpValue C-Win 
FUNCTION setGrpValue RETURNS LOGICAL
  ( INPUT icField AS CHAR,INPUT icValue AS CHAR ) :
/*------------------------------------------------------------------------------
  Purpose:  
    Notes:  
------------------------------------------------------------------------------*/
DEF VAR ix AS INT NO-UNDO.
DEF VAR iNumSel AS INT NO-UNDO.

iNumSel = BROWSE brwViperGrp:NUM-SELECTED-ROWS.

DO ix = 1 TO iNumSel:
  IF BROWSE brwViperGrp:FETCH-SELECTED-ROW(ix) THEN
    BUFFER ttViperGrp:BUFFER-FIELD(icField):BUFFER-VALUE = icValue.
END.

IF iNumSel > 1 THEN DO:
  {&OPEN-QUERY-brwViperGrp}
  BROWSE brwViperGrp:SELECT-ROW(1).
  APPLY "value-changed" TO BROWSE brwViperGrp.
END.
ELSE BROWSE brwViperGrp:REFRESH().

RETURN YES.

END FUNCTION.

