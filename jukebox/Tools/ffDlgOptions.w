&Scoped-define SELF-NAME btnPreviewViper
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btnPreviewViper C-Win
ON CHOOSE OF btnPreviewViper IN FRAME DEFAULT-FRAME /* Open in Viper designer */
DO:
  DEF VAR cProwc      AS CHAR NO-UNDO.
  DEF VAR cWorkDir    AS CHAR NO-UNDO.
  DEF VAR oStartInfo  AS System.Diagnostics.ProcessStartInfo NO-UNDO.
  DEF VAR oProcess    AS System.Diagnostics.Process NO-UNDO.
  DEF VAR bOk         AS LOG NO-UNDO.

  IF SEARCH(fiViperName:SCREEN-VALUE) NE ? THEN DO:
    MESSAGE "Replace " fiViperName:SCREEN-VALUE
      VIEW-AS ALERT-BOX INFORMATION BUTTONS OK-CANCEL UPDATE bOK.
    IF NOT bOK THEN RETURN NO-APPLY.
  END.
  OUTPUT STREAM sViper TO VALUE(fiViperName:SCREEN-VALUE).
  PUT STREAM sViper UNFORMATTED getViperGroupDef ("").
  OUTPUT STREAM sViper CLOSE.

  IF SEARCH("vfd.pf") = ? THEN DO:
    MESSAGE "Viper designer programs missing from PROPATH" SKIP
      VIEW-AS ALERT-BOX WARNING BUTTONS OK.
    OS-COMMAND NO-WAIT VALUE("notepad " + fiViperName:SCREEN-VALUE).
    RETURN NO-APPLY.
  END.

  FILE-INFO:FILE-NAME = IF SEARCH("prowin32.exe") NE ? THEN SEARCH("prowin32.exe") ELSE SEARCH("prowin.exe"). 
  cProwc = '"' + FILE-INFO:FULL-PATHNAME + '"'.  
  FILE-INFO:FILENAME = SEARCH("vfd.pf").
  cWorkDir = SUBSTR(FILE-INFO:FULL-PATHNAME,1,R-INDEX(FILE-INFO:FULL-PATHNAME,"\")).

  oStartInfo = NEW System.Diagnostics.ProcessStartInfo().
  oStartInfo:FileName = cProwc.
  oStartInfo:Arguments = '-pf vfd.pf -noincrwarn -debugalert -wy -param "' + fiViperName:SCREEN-VALUE + '" -T ' + SESSION:TEMP-DIR.
  oStartInfo:WorkingDirectory = cWorkDir.
  /* optionally obtain access to stdout of the process */
  oStartInfo:UseShellExecute = NO.
  oStartInfo:RedirectStandardOutput = YES.

  oProcess = System.Diagnostics.Process:Start (oStartInfo).

  CATCH e AS Progress.Lang.Error:
    MESSAGE "Invalid filename:" fiViperName:SCREEN-VALUE
      VIEW-AS ALERT-BOX INFORMATION BUTTONS OK.
    RETURN NO-APPLY.
  END CATCH.

/*
  IF SEARCH("vfd/v0010oth.w") NE ? THEN DO:
    IF VALID-HANDLE(hViperPreview) THEN DO:
      IF NOT bOk THEN
        MESSAGE "Reload preview?" 
          VIEW-AS ALERT-BOX INFORMATION BUTTONS OK-CANCEL UPDATE bOk.
      IF NOT bOK THEN RETURN NO-APPLY.
      ELSE DELETE PROCEDURE hViperPreview.
    END.
    RUN "vfd/v0010oth.w" PERSISTENT SET hViperPreview.
    RUN openVFR IN hViperPreview (fiViperName:SCREEN-VALUE) .
  END.
  */
END.

