  RUN JBoxAskForValue.w ("Insert group after " + ttViperGrp.cViperGrp,"CHARACTER|x(20)",INPUT-OUTPUT cReturn,OUTPUT iReturn).
  IF iReturn = 2 AND cReturn NE "" AND NOT CAN-FIND(FIRST bttViperGrp WHERE bttViperGrp.cViperGrp = cReturn) THEN DO:
    FOR EACH bttViperGrp 
        WHERE bttViperGrp.iViperGrpSeq > ttViperGrp.iViperGrpSeq
           BY bttViperGrp.iViperGrpSeq DESC
       :
      bttViperGrp.iViperGrpSeq = bttViperGrp.iViperGrpSeq + 1.
    END.
    CREATE bttViperGrp.
    ASSIGN bttViperGrp.cViperGrp = cReturn
           bttViperGrp.iViperGrpSeq = ttViperGrp.iViperGrpSeq + 1
           bttViperGrp.cGroupType = "data"
           bttViperGrp.iViperHeight    = 60
           bttViperGrp.iWfact     = 15
           bttViperGrp.cAlign     = "left"
           .
    {&OPEN-QUERY-brwViperGrp}
  END.  
END.

