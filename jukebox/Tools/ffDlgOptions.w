&ANALYZE-SUSPEND _UIB-CODE-BLOCK _FUNCTION initSeq C-Win 
FUNCTION initSeq RETURNS LOGICAL
  ( INPUT icTable AS CHARACTER,INPUT iiSeq AS INTEGER ) :
/*------------------------------------------------------------------------------
  Purpose:  
    Notes:  
------------------------------------------------------------------------------*/
DEF BUFFER bttTableFld FOR ttTableFld.
FOR EACH bttTableFld
    WHERE bttTableFld.cTable       = icTable
      AND bttTableFld.iViperGrpSeq = 0
  :
  bttTableFld.iViperGrpSeq = iiSeq.
END.
  
RETURN YES.

END FUNCTION.

