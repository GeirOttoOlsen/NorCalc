&ANALYZE-SUSPEND _UIB-CODE-BLOCK _FUNCTION setGrpFlds C-Win 
FUNCTION setGrpFlds RETURNS LOGICAL
  ( INPUT ihWidget AS HANDLE ) :
/*------------------------------------------------------------------------------
  Purpose:  
    Notes:  
------------------------------------------------------------------------------*/
DO WITH FRAME {&FRAME-NAME}:
  IF NOT VALID-HANDLE(ihWidget) THEN DO: 
    IF AVAIL ttViperGrp THEN DO: 
      bHorizontal:CHECKED = ttViperGrp.bHorizontal.
      bHorizontal:SENSITIVE = ttViperGrp.cGroupType = "data" AND BROWSE brwViperGrp:NUM-SELECTED-ROWS = 1.
    
      tbGrpLabels:CHECKED = ttViperGrp.cGroupType = "data" AND ttViperGrp.cLabelGrp NE "".
      tbGrpLabels:SENSITIVE = ttViperGrp.cGroupType = "data" AND BROWSE brwViperGrp:NUM-SELECTED-ROWS = 1.
      SideTopLabels:VISIBLE = tbGrpLabels:CHECKED AND bHorizontal:CHECKED.
    
      iHorizontalSkip:VISIBLE = bHorizontal:CHECKED.
    
      IF iHorizontalSkip:HIDDEN THEN
        iHorizontalSkip:SCREEN-VALUE = "0".
      ELSE
        iHorizontalSkip:SCREEN-VALUE = STRING(ttViperGrp.iHorizontalSkip).

      btnGrpUp:SENSITIVE = NOT CAN-FIND(FIRST ttViperGrp WHERE ttViperGrp.iGroupLabelSeq > 0).
      btnGrpDown:SENSITIVE = btnGrpUp:SENSITIVE.
    
      ASSIGN cAlign:SCREEN-VALUE = ttViperGrp.cAlign
             iViperHeight:SCREEN-VALUE = STRING(ttViperGrp.iViperHeight)
             iWfact:SCREEN-VALUE = STRING(ttViperGrp.iWfact)
             grpFont:SCREEN-VALUE = ttViperGrp.grpFont
             SideTopLabels:SCREEN-VALUE = (IF ttViperGrp.SideTopLabels NE 0 THEN STRING(ttViperGrp.SideTopLabels) ELSE "1")
             .
    
    END.
  END.
  ELSE CASE ihWidget:NAME:
    WHEN "bHoriszontal" THEN
      ASSIGN SideTopLabels:VISIBLE = ihWidget:CHECKED AND tbGrpLabels:CHECKED
             iHorizontalSkip:HIDDEN = SideTopLabels:HIDDEN
             .
//    WHEN "tbGrpLabels" THEN
//      ASSIGN SideTopLabels:VISIBLE = ihWidget:CHECKED AND bHorizontal:CHECKED
//             .
  END.
END.
RETURN YES.

END FUNCTION.

