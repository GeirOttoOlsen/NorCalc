&ANALYZE-SUSPEND _UIB-CODE-BLOCK _FUNCTION ViewText C-Win 
FUNCTION ViewText RETURNS LOGICAL
  ( INPUT icText AS CHAR ) :
/*------------------------------------------------------------------------------
  Purpose:  
    Notes:  
------------------------------------------------------------------------------*/
DEF VAR cFileName AS CHAR NO-UNDO.

cFileName = SESSION:TEMP-DIR + STRING(TIME) + ".txt".

OUTPUT STREAM sViper TO VALUE(cFileName).
PUT STREAM sViper UNFORMATTED icText.
OUTPUT STREAM sViper CLOSE.

OS-COMMAND NO-WAIT VALUE("notepad " + cFileName).

RETURN YES.

END FUNCTION.

