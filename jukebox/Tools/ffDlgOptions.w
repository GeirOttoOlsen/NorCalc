&ANALYZE-SUSPEND _UIB-CODE-BLOCK _FUNCTION moveFlds C-Win 
FUNCTION moveFlds RETURNS LOGICAL
  ( INPUT icUpDown AS CHARACTER ) :
/*------------------------------------------------------------------------------
  Purpose:  
    Notes:  
------------------------------------------------------------------------------*/
DEF VAR ix         AS INT  NO-UNDO.
DEF VAR iSeq       AS INT  NO-UNDO.
DEF VAR cSelList   AS CHAR NO-UNDO.

DEF BUFFER bttTableFld FOR ttTableFld.

DO WITH FRAME {&FRAME-NAME}:
  EMPTY TEMP-TABLE ttSort.

  DO ix = 1 TO BROWSE brwViperGrpFields:NUM-SELECTED-ROWS:
    IF BROWSE brwViperGrpFields:FETCH-SELECTED-ROW(ix) THEN DO:
      CREATE ttSort.
      ASSIGN ttSort.iSeq     = ttTableFld.iDesignSeq
             ttSort.rRowid   = ROWID(ttTableFld)
             cSelList        = cSelList + (IF cSelList NE "" THEN "," ELSE "") + STRING(ttTableFld.iDesignSeq)
             .
    END.
  END.
  IF icUpDown = "up" THEN DO:
    FOR EACH ttSort BY iSeq:
      FIND FIRST ttTableFld WHERE ROWID(ttTableFld) = ttSort.rRowid.
      FOR EACH bttTableFld
          WHERE bttTableFld.cViperGrp = ttTableFld.cViperGrp
            AND bttTableFld.iDesignSeq < ttSort.iSeq
            AND NOT CAN-DO(cSelList,STRING(bttTableFld.iDesignSeq))
          BY bttTableFld.iDesignSeq DESC:
        LEAVE.
      END.
      IF NOT AVAIL bttTableFld THEN RETURN NO.
      LEAVE.
    END.
    FOR EACH ttSort BY ttSort.iSeq DESC:
      FIND FIRST ttTableFld WHERE ROWID(ttTableFld) = ttSort.rRowid.
      FOR EACH bttTableFld
          WHERE bttTableFld.cViperGrp = ttTableFld.cViperGrp
            AND bttTableFld.iDesignSeq < ttSort.iSeq
            AND NOT CAN-DO(cSelList,STRING(bttTableFld.iDesignSeq))
          BY bttTableFld.iDesignSeq DESC:
        LEAVE.
      END.
      IF AVAIL bttTableFld THEN 
        ASSIGN iSeq = bttTableFld.iDesignSeq
               bttTableFld.iDesignSeq = ttTableFld.iDesignSeq
               ttTableFld.iDesignSeq = iSeq.
    END.
  END.
  ELSE DO:
    FOR EACH ttSort BY ttSort.iSeq DESC:
      FIND FIRST ttTableFld WHERE ROWID(ttTableFld) = ttSort.rRowid.
      FOR EACH bttTableFld
          WHERE bttTableFld.cViperGrp = ttTableFld.cViperGrp
            AND bttTableFld.iDesignSeq > ttSort.iSeq
            AND NOT CAN-DO(cSelList,STRING(bttTableFld.iDesignSeq))
          BY bttTableFld.iDesignSeq:
        LEAVE.
      END.
      IF NOT AVAIL bttTableFld THEN RETURN NO.
      LEAVE.
    END.
    FOR EACH ttSort BY ttSort.iSeq:
      ix = ix + 1.
      FIND FIRST ttTableFld WHERE ROWID(ttTableFld) = ttSort.rRowid.
      FOR EACH bttTableFld
          WHERE bttTableFld.cViperGrp = ttTableFld.cViperGrp
            AND bttTableFld.iDesignSeq > ttTableFld.iDesignSeq
            AND NOT CAN-DO(cSelList,STRING(bttTableFld.iDesignSeq))
          BY bttTableFld.iDesignSeq:
        LEAVE.
      END.
      IF AVAIL bttTableFld THEN 
        ASSIGN iSeq = bttTableFld.iDesignSeq
               bttTableFld.iDesignSeq = ttTableFld.iDesignSeq
               ttTableFld.iDesignSeq = iSeq.
    END.
  END.

  APPLY "value-changed" TO brwViperGrp.
  FOR EACH ttSort:
    BROWSE brwViperGrpFields:QUERY:REPOSITION-TO-ROWID(ttSort.rRowid).
    BROWSE brwViperGrpFields:SELECT-ROW(BROWSE brwViperGrpFields:FOCUSED-ROW).
  END.
END.
  
RETURN YES.

END FUNCTION.

