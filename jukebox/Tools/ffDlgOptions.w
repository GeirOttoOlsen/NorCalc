&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE addTable C-Win 
PROCEDURE addTable :
/*------------------------------------------------------------------------------
 Purpose:
 Notes:
------------------------------------------------------------------------------*/
DEF INPUT PARAM ihBuffer AS HANDLE NO-UNDO.

DEF VAR iNextTableSeq    AS INT NO-UNDO.
DEF VAR iNextViperGrpSeq AS INT NO-UNDO.
DEF VAR ix               AS INT NO-UNDO.

DEF VAR hQ AS HANDLE NO-UNDO.
DEF BUFFER ttTableFld FOR TEMP-TABLE ttTableFld.

FOR EACH ttTableFld
    BY ttTableFld.iTableSeq DESC:
  iNextTableSeq = ttTableFld.iTableSeq + 1.
  LEAVE.
END.
FOR EACH ttTableFld
    BY ttTableFld.iViperGrpSeq DESC:
  iNextViperGrpSeq = ttTableFld.iViperGrpSeq + 1.
  LEAVE.
END.

CREATE QUERY hQ.
hQ:SET-BUFFERS (ihBuffer).
hQ:QUERY-PREPARE ("FOR EACH " + ihBuffer:NAME).
hQ:QUERY-OPEN ().
REPEAT WHILE hQ:GET-NEXT():
  FIND FIRST ttTableFld
       WHERE ttTableFld.cTable = ihBuffer::cTable
         AND ttTableFld.cDbFld = ihBuffer::cDbFld
       NO-ERROR.
  IF NOT AVAIL ttTableFld THEN DO:
    CREATE ttTableFld.
    BUFFER ttTableFld:BUFFER-COPY(ihBuffer).
    ttTableFld.iTableSeq = iNextTableSeq.
    ttTableFld.cViperGrp = ttTableFld.cTable.
    ttTableFld.iViperWidth = IF ttTableFld.fWidthChars NE 0 THEN MIN(800, ttTableFld.fWidthChars * ttViperGrp.iWfact) ELSE 100.
    ttTableFld.cTtFld = ihBuffer::cDbFld.
    ttTableFld.fldFont = "0".
    IF ix = 0 THEN DO:
      CREATE ttViperGrp.
      ASSIGN ttViperGrp.cViperGrp = ttTableFld.cTable
             ttViperGrp.iViperGrpSeq = iNextViperGrpSeq
             ttViperGrp.cGroupType   = "data"
             ttViperGrp.cAlign       = "Default" 
             ttViperGrp.iViperHeight = 60
             ttViperGrp.iWfact       = 15
             ttViperGrp.grpFont      = "0"
             .
    END.         
    ASSIGN ix = ix + 1
           ttTableFld.iSeq = ix
           ttTableFld.iDesignSeq = ix
           ttTableFld.iViperGrpSeq = iNextViperGrpSeq
           .
  END.
END.  

IF tbViper:CHECKED IN FRAME {&FRAME-NAME} THEN
  {&OPEN-QUERY-brwViperGrp}

END PROCEDURE.

