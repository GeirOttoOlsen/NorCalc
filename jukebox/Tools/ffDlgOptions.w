DO:
  DEF BUFFER bttViperGrp FOR ttViperGrp.
  IF ttViperGrp.cGroupType = "data" AND ttViperGrp.cLabelGrp NE "" THEN
    FOR EACH bttViperGrp
        WHERE bttViperGrp.cLabelGrp = ttViperGrp.cLabelGrp:
      FOR EACH ttTableFld
          WHERE ttTableFld.cViperGrp = bttViperGrp.cViperGrp:
        DELETE ttTableFld.
      END.
      DELETE bttViperGrp.
    END.
  ELSE DO:
    FOR EACH ttTableFld
        WHERE ttTableFld.cViperGrp = ttViperGrp.cViperGrp:
      DELETE ttTableFld.
    END.
    DELETE ttViperGrp.
