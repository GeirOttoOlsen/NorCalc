      END.
      IF NOT AVAIL bttViperGrp THEN RETURN NO.
      LEAVE.
    END.
    FOR EACH ttSort BY ttSort.iSeq:
      ix = ix + 1.
      FOR EACH bttViperGrp
          WHERE bttViperGrp.iViperGrpSeq > ttViperGrp.iViperGrpSeq
            AND NOT CAN-DO(cSelList,STRING(bttViperGrp.iViperGrpSeq))
