&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE InitWindow C-Win 
PROCEDURE InitWindow :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
DEF BUFFER bttTableFld FOR TEMP-TABLE ttTableFld.
DEF VAR ix AS INT NO-UNDO.

DO WITH FRAME {&FRAME-NAME}:
  IF NOT CAN-DO(hParent:INTERNAL-ENTRIES,"genViewDef") THEN 
    ASSIGN Btn_OK:HIDDEN = YES
           Btn_Cancel:LABEL = "Done".

  BUFFER ttTableFld:HANDLE:COPY-TEMP-TABLE(ihbttTableFld,NO,NO,YES).

  FOR EACH bttTableFld:
    IF CAN-DO("jbCountDistinct,jbAverage",bttTableFld.cTtFld) THEN DELETE bttTableFld.
    ELSE
      IF bttTableFld.iDesignSeq = 0 THEN
        ASSIGN ix = ix + 1
               bttTableFld.iDesignSeq = ix.
  END.

  FOR EACH bttTableFld
      BY bttTableFld.iDesignSeq
      :
    initSeq(bttTableFld.cTable,bttTableFld.iDesignSeq). 
  END.

  FOR EACH ttTableFld
      BREAK BY ttTableFld.iViperGrpSeq:
    ttTableFld.cViperGrp = ttTableFld.cTable.
    IF FIRST-OF(ttTableFld.iViperGrpSeq) THEN DO:
      CREATE ttViperGrp.
      ASSIGN ttViperGrp.cViperGrp = ttTableFld.cTable
             ttViperGrp.iViperGrpSeq = ttTableFld.iViperGrpSeq
             ttViperGrp.cGroupType   = "data"
             ttViperGrp.cAlign       = "Default" 
             ttViperGrp.iViperHeight = 60
             ttViperGrp.iWfact       = 15
             ttViperGrp.grpFont      = "0"
             .
      IF cRepName = "" THEN cRepName = ttViperGrp.cViperGrp.
    END.
    ttTableFld.iViperWidth = IF ttTableFld.fWidthChars NE 0 THEN MIN(800, ttTableFld.fWidthChars * ttViperGrp.iWfact) ELSE 100.
    ttTableFld.fldFont = "0".
    IF ttTableFld.cTtFld = "" THEN ttTableFld.cTtFld = ttTableFld.cDbFld.
  END. 
    
  BROWSE brwViperGrp:COLUMN-RESIZABLE = YES.
  BROWSE brwViperGrpFields:COLUMN-RESIZABLE = YES.
//  fiViperName:SCREEN-VALUE = DYNAMIC-FUNCTION("get_OBJECT_NAME").
  fiViperName:SCREEN-VALUE = SESSION:TEMP-DIRECTORY + cRepName + ".vfr".
  
  tbDataset:HIDDEN = YES.

  IF icParam NE "viper" THEN
    HIDE {&LIST-1}.
  ELSE DO: 
    tbViper:CHECKED = YES.
    APPLY "value-changed" TO tbViper.
  END.

  initFonts().

  tbPosition:CHECKED = YES.
  tbPosition:HIDDEN = YES.
  creDynQuery:HIDDEN = YES.
  SideTopLabels:HIDDEN = YES.
/*  THIS-PROCEDURE:CURRENT-WINDOW:Y  = ROUND(MAXIMUM(10, (SESSION:HEIGHT-PIXELS                                                         */
/*                       - THIS-PROCEDURE:CURRENT-WINDOW:HEIGHT-PIXELS) / 2) - THIS-PROCEDURE:CURRENT-WINDOW:HEIGHT-PIXELS, 0) NO-ERROR.*/
  THIS-PROCEDURE:CURRENT-WINDOW:X = ROUND(MAXIMUM(1, (SESSION:WIDTH-PIXELS 
                       - THIS-PROCEDURE:CURRENT-WINDOW:WIDTH-PIXELS) / 2), 0) NO-ERROR.

  DYNAMIC-FUNCTION("setSplitBarY",THIS-PROCEDURE:CURRENT-WINDOW,btnSplitBarY:HANDLE IN FRAME {&FRAME-NAME},NO).
  DYNAMIC-FUNCTION("setFollowSplitBarY",THIS-PROCEDURE:CURRENT-WINDOW,btnSplitBarY:HANDLE IN FRAME {&FRAME-NAME},
                   STRING(BROWSE brwViperGrp:HANDLE) + "," + STRING(BROWSE brwViperGrpFields:HANDLE) 
                   + "," + STRING(btnFldUp:HANDLE) + "," + STRING(btnFldDown:HANDLE) + "," + STRING(iViperWidth:HANDLE)
                   + "," + STRING(fldFont:HANDLE) + "," + STRING(cAlignFld:HANDLE)
                   ).
  DYNAMIC-FUNCTION("setSplitBarYLimits",btnSplitBarY:HANDLE IN FRAME {&FRAME-NAME},260,200).

  DYNAMIC-FUNCTION("setNoResizeY", THIS-PROCEDURE:CURRENT-WINDOW, FRAME {&FRAME-NAME}:HANDLE, "edDynQuery,brwViperGrp").
  DYNAMIC-FUNCTION("setAddMoveX", THIS-PROCEDURE:CURRENT-WINDOW, FRAME {&FRAME-NAME}:HANDLE, "btnPreviewViper,Btn_OK,btnCreViperDS,fldFont,cAlignFld").
  DYNAMIC-FUNCTION("setOrgWinSize", THIS-PROCEDURE:CURRENT-WINDOW,420,330,0,200).

  THIS-PROCEDURE:CURRENT-WINDOW:HIDDEN = NO.
  THIS-PROCEDURE:CURRENT-WINDOW:ALWAYS-ON-TOP = YES.
  STATUS INPUT OFF IN WINDOW {&WINDOW-NAME}.
END.
END PROCEDURE.

