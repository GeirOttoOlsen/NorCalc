ON CHOOSE OF MENU-ITEM m_Add_back /* Add (back) */
DO:
  DEF VAR ix AS INT NO-UNDO.
  DEF VAR cClip AS CHAR NO-UNDO.

  JBoxServerAPI:Instance:Selector(BUFFER ttTableFld:HANDLE,"cTtFld").
  IF JBoxServerAPI:Instance:SelectorOk THEN DO:
    cClip = JBoxServerAPI:Instance:SelectorReturnValueList.
    DO ix = 1 TO NUM-ENTRIES(cClip,"|"):
      FIND FIRST ttTableFld
           WHERE ttTableFld.cViperGrp = ttViperGrp.cViperGrp
             AND ttTableFld.cTtFld = ENTRY(ix,cClip,"|")
           NO-ERROR.  
      IF AVAIL ttTableFld THEN
        ttTableFld.bDeleted = NO.
    END.
    {&OPEN-QUERY-brwViperGrpFields}
  END.  
END.

