&Scoped-define SELF-NAME btnCreViperDS
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btnCreViperDS C-Win
ON CHOOSE OF btnCreViperDS IN FRAME DEFAULT-FRAME /* Create Viper DataSet */
DO:
  DEF VAR cDS        AS CHAR NO-UNDO.
  DEF VAR cTableList AS CHAR NO-UNDO.
  DEF VAR ix         AS INT  NO-UNDO.

  DEFINE BUFFER ttViperGrp FOR ttViperGrp.
  DEFINE BUFFER ttTableFld FOR ttTableFld.

  FOR EACH ttViperGrp 
      WHERE NOT ttViperGrp.cViperGrp MATCHES "*JBlabels"
      BY ttViperGrp.iViperGrpSeq
      :
    IF NOT  CAN-FIND(FIRST ttTableFld WHERE ttTableFld.cViperGrp = ttViperGrp.cViperGrp) THEN NEXT.

    ix = ix + 1.
    cTableList = cTableList + (IF cTableList NE "" THEN ", " ELSE "") + "vp" + ttViperGrp.cViperGrp.
    cDS = cDS + "DEFINE TEMP-TABLE vp" + ttViperGrp.cViperGrp + CHR(10).
    FOR EACH ttTableFld WHERE ttTableFld.cViperGrp = ttViperGrp.cViperGrp AND NOT ttTableFld.bDeleted:
      cDS = cDS + "    FIELD " + ttTableFld.cTtFld + " AS "
          + (IF ttViperGrp.cViperGrp MATCHES "*JBlabels" THEN "CHARACTER" 
             ELSE ttTableFld.cDataType 
                  + " LABEL '" 
                  + (IF ttTableFld.cLabel NE ? THEN ttTableFld.cLabel ELSE ttTableFld.cTtFld) 
                  + "'") + CHR(10).
    END.
    cDS = cDS + "." + CHR(10) + CHR(10)
        + "DEF VAR hvp" + ttViperGrp.cViperGrp + " AS HANDLE NO-UNDO." + CHR(10)
        + "hvp" + ttViperGrp.cViperGrp + " = BUFFER vp" + ttViperGrp.cViperGrp + ":HANDLE." + CHR(10) + CHR(10).
  END.  
  cDS = "/* For DEFINITIONS: */ " + CHR(10)
      + cDS + "DEFINE DATASET dsViper" + cRepName + " FOR " + cTableList + "." + CHR(10) + CHR(10)
      + "DEF VAR hdsViper" + cRepName + " AS HANDLE NO-UNDO." + CHR(10)
      + "hdsViper" + cRepName + " = DATASET dsViper" + cRepName + ":HANDLE." + CHR(10)
      + "/* End DEFINITIONS */" + CHR(10) + CHR(10)
      + "/* For runReport: */" + CHR(10)
      + "oReport:loadVfrFile ('" + fiViperName:SCREEN-VALUE + "','portrait')." + CHR(10)
      + "oReport:activateDocumentLayout('" + cRepName + "')." + CHR(10)
      + "oReport:loadImage('jpg/ChemistryHvitRGB.jpg', 50, 50, 500, 250)." + CHR(10) + CHR(10)
      + "/*" + CHR(10) 
      + " If producing the report on the client this is the place to go and fetch data from the server: " + CHR(10) 
      + "IF NOT JBoxServerAPI:Instance:CallServerProc(" + cRepName + "_data.p,<Parameter>,hdsViper" + cRepName + ") THEN DO:" + CHR(10)
      + "  ocReturn = JBoxServerAPI:Instance:getCallMessage()." + CHR(10)
      + "  RETURN." + CHR(10)
      + "END." + CHR(10) 
      + "*/" + CHR(10)    
      + "// If you have db access, otherwise FIND vp" + cRepName + " and skip the create/buffer-copy" + CHR(10)
      + "FIND FIRST " + cRepName + " /*WHERE something*/ NO-LOCK NO-ERROR." + CHR(10)
      + "IF AVAIL " + cRepName + " THEN DO:" + CHR(10)
      + "  CREATE vp" + cRepName + "." + CHR(10)
      + "  BUFFER-COPY " + cRepName + " TO vp" + cRepName + "." + CHR(10) + CHR(10) 
      + "  //oReport:autoFillLabelGroup(hvp" + cRepName + ",'" + cRepName + "', ?). /* if label group is defined */" + CHR(10)
      + "  oReport:autoFillGroup(hvp" + cRepName + ",'" + cRepName + "',?)." + CHR(10) + CHR(10)
      + "  // FOR EACH lines and so on.." + CHR(10) 
      + "END." + CHR(10)
      .
  
  ViewText(cDS).
END.

