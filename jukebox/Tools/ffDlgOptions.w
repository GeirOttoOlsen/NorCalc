&ANALYZE-RESUME


&Scoped-define SELF-NAME m_Move_to_group
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL m_Move_to_group C-Win
ON CHOOSE OF MENU-ITEM m_Move_to_group /* Move to group */
DO:
  DEF VAR cList     AS CHAR NO-UNDO.
  DEF VAR cReturn   AS CHAR NO-UNDO.
  DEF VAR ix        AS INT  NO-UNDO.
  DEF VAR iStartSeq AS INT  NO-UNDO.
  DEF BUFFER bttViperGrp FOR ttViperGrp.
  DEF BUFFER bttTableFld FOR ttTableFld.
  DEF VAR cMoveFrom AS CHAR NO-UNDO.

  IF ttViperGrp.cGroupType = "label" THEN DO:
    MESSAGE 'Fields can only be moved from a "field" group' SKIP
             'Corresponding labels will follow automatically'
             VIEW-AS ALERT-BOX.
    RETURN NO-APPLY. 
  END.
  FOR EACH bttViperGrp WHERE bttViperGrp.cViperGrp NE ttViperGrp.cViperGrp AND bttViperGrp.cGroupType = "data":
    cList = cList + (IF cList NE "" THEN "|" ELSE "") + bttViperGrp.cViperGrp + "|" + bttViperGrp.cViperGrp.
  END.
  IF cList NE "" THEN DO:
    RUN JBoxDSimpleSelectList.w (cList,?,OUTPUT cReturn).
    IF cReturn NE ? THEN DO:
      FOR EACH bttTableFld WHERE bttTableFld.cViperGrp = cReturn
          BY bttTableFld.iSeq DESC:
        iStartSeq = bttTableFld.iSeq.
        LEAVE.
      END.
      DO ix = 1 TO BROWSE brwViperGrpFields:NUM-SELECTED-ROWS:
        IF BROWSE brwViperGrpFields:FETCH-SELECTED-ROW(ix) THEN DO:
          IF cMoveFrom = "" THEN cMoveFrom = ttTableFld.cViperGrp.
          ASSIGN iStartSeq = iStartSeq + 1
                 ttTableFld.cViperGrp = cReturn
                 ttTableFld.iSeq = iStartSeq
                 .
          FIND FIRST bttTableFld 
               WHERE bttTableFld.cViperGrp = ttViperGrp.cViperGrp + "_JBlabels"
                 AND bttTableFld.cTtFld    = ttTableFld.cTtFld + "_JBlabel"     
               NO-ERROR.
          IF AVAIL bttTableFld THEN
            ASSIGN bttTableFld.cViperGrp = ttViperGrp.cViperGrp + "_JBlabels"
                   bttTableFld.iSeq      = iStartSeq
                   .
        END.
      END.
      ix = 0.
      FOR EACH bttTableFld 
          WHERE bttTableFld.cViperGrp = cMoveFrom:
        bttTableFld.iSeq = ttTableFld.iSeq - 100.
        ix = ix + 1.
      END.
      iStartSeq = ix.
      FOR EACH bttTableFld 
          WHERE bttTableFld.cViperGrp = cMoveFrom
             BY bttTableFld.iSeq DESC:
        ASSIGN bttTableFld.iSeq = iStartSeq
               iStartSeq  = iStartSeq - 1.
      END.

      APPLY "value-changed" TO BROWSE brwViperGrp.
    END.
  END.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME m_New_group
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL m_New_group C-Win
ON CHOOSE OF MENU-ITEM m_New_group /* New group */
DO:
