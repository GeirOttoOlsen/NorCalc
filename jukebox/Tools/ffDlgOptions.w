DEF VAR iMaxW  AS INT NO-UNDO.
DEF VAR iDeltaX AS INT NO-UNDO.

DEF VAR cVfd            AS CHAR NO-UNDO.
DEF VAR eol             AS CHAR NO-UNDO.
DEF VAR e2ol            AS CHAR NO-UNDO.
DEF VAR cHeader         AS CHAR NO-UNDO.
DEF VAR cPrevGrpType    AS CHAR NO-UNDO.
DEF VAR iPrevGrpSeq     AS INT  NO-UNDO.
DEF VAR bPrevGrpHor     AS LOG  NO-UNDO.
DEF VAR iPrevGrpStartX  AS INT  NO-UNDO.
DEF VAR iPrevGrpStartY  AS INT  NO-UNDO.
DEF VAR cAlign          AS CHAR NO-UNDO.

DEF BUFFER ttTableFld  FOR ttTableFld.
DEF BUFFER bttTableFld FOR ttTableFld.

eol = CHR(10).
e2ol = eol + eol.

IF icGrp = "" THEN
  cVfd = getReportTemplate().

FOR EACH ttViperGrp:
  iCnt = 0.
  iMaxW = 0.
  FOR EACH ttTableFld 
      WHERE ttTableFld.cViperGrp = ttViperGrp.cViperGrp
        AND NOT ttTableFld.bDeleted:
    iCnt = iCnt + 1.
    /* ttTableFld.iViperWidth = IF ttTableFld.fWidthChars NE 0 THEN MIN(800, ttTableFld.fWidthChars * ttViperGrp.iWfact) ELSE 100. */
    iMaxW = MAX(iMaxW,ttTableFld.iViperWidth).
  END.
  ttViperGrp.iNumFlds = iCnt.
  ttViperGrp.iMaxFieldWidth = iMaxW.
END.

FOR EACH ttViperGrp
    WHERE ttViperGrp.bHorizontal
      AND ttViperGrp.SideTopLabels = 2
    :
  FOR EACH ttTableFld
      WHERE ttTableFld.cViperGrp = ttViperGrp.cViperGrp
        AND NOT ttTableFld.bDeleted
         BY ttTableFld.iDesignSeq:

    FIND FIRST bttTableFld
         WHERE bttTableFld.cViperGrp = ttTableFld.cViperGrp + "_JBlabels"
           AND bttTableFld.cTtFld    = ttTableFld.cTtFld + "_JBlabel"
         NO-ERROR.
    IF AVAIL bttTableFld THEN DO:
      IF ix = 0 THEN 
        ASSIGN bttTableFld.iViperX = 20 
               ix = ix + bttTableFld.iViperWidth + 10.
      ELSE 
        ASSIGN bttTableFld.iViperX = ix + 10
               ix = ix + 10 + bttTableFld.iViperWidth.
    END.
    ELSE IF ix = 0 THEN ix = 20.

    ASSIGN ttTableFld.iViperX = ix
           ix = ix + 10 + ttTableFld.iViperWidth.
  END.
END.

FOR EACH ttViperGrp
    WHERE IF icGrp NE "" THEN ttViperGrp.cViperGrp = icGrp ELSE TRUE
         ,EACH ttTableFld 
               WHERE ttTableFld.cViperGrp = ttViperGrp.cViperGrp
                 AND NOT ttTableFld.bDeleted
    BREAK BY ttViperGrp.iViperGrpSeq
          BY ttViperGrp.iGroupLabelSeq
          BY ttTableFld.iDesignSeq
    :
  IF FIRST-OF(ttViperGrp.iGroupLabelSeq) THEN DO:
    ASSIGN cVfd = cVfd + e2ol 
                + "BeginObject=Group" + eol
                + "    Name=" + ttViperGrp.cViperGrp + eol
                + (IF ttViperGrp.bHorizontal AND ttViperGrp.cGroupType NE "label" AND ttViperGrp.iHorizontalSkip > 0 THEN
                    "    PreSkip=" + STRING(ttViperGrp.iHorizontalSkip) + eol
//                  + "    PostSkip=10" + e2ol
                   ELSE eol)
           .
    IF iPrevGrpSeq = ttViperGrp.iViperGrpSeq THEN DO:
      IF bPrevGrpHor THEN
        ASSIGN ix = iPrevGrpStartX
               iy = iPrevGrpStartY + (IF ttViperGrp.SideTopLabels = 2 THEN 0 ELSE 70).
      ELSE
        ASSIGN ix = iPrevGrpStartX + 300
               iy = iPrevGrpStartY.

    END.
    ELSE DO:
      IF ttViperGrp.bHorizontal THEN
        ix = 0.
      ELSE
        ix = IF iy > 2000 THEN 1000 ELSE 100.
      iy = IF iy > 2000 THEN 150 ELSE iy + 150.
    END.
    ASSIGN iPrevGrpStartX = ix
           iPrevGrpStartY = iy.
  END.
  IF ttViperGrp.bHorizontal THEN
    ix = IF ttTableFld.iViperX > 0 THEN ttTableFld.iViperX ELSE ix + 2000 / ttViperGrp.iNumFlds.
  ELSE
    iy = iy + ttViperGrp.iViperHeight + 10.  
  
  cAlign = IF ttViperGrp.cAlign = "default" THEN
             (IF CAN-DO("decimal,integer",ttTableFld.cDataType) THEN "Right" ELSE "Left")
           ELSE ttViperGrp.cAlign.

  cVfd = cVfd + eol
              + "BeginObject=Cell" + eol
              + "    Name=" + ttTableFld.cTtFld + eol
              + "    X-mm=" + STRING(ix + (IF ttViperGrp.cAlign = "right" THEN ttViperGrp.iMaxFieldWidth - ttTableFld.iViperWidth ELSE 0)) + eol
              + "    Y-mm=" + STRING(iy) + eol
              + "    Width-mm=" + STRING(ttTableFld.iViperWidth) + eol
              + "    Height-mm=" + STRING(ttViperGrp.iViperHeight) + eol
              + "    Alignment=" + cAlign + eol
              + "    Autowrap=false" + eol
              + "    AutoResize=no" + eol
              + "    FgColour=0,0,0" + eol
              + (IF ttTableFld.fldFont NE "0" THEN "    FontNo=" + ttTableFld.fldFont ELSE IF ttViperGrp.grpFont NE "0" THEN "    FontNo=" + ttViperGrp.grpFont + CHR(10) ELSE "") + eol
              + "EndObject=Cell" + e2ol
              .
  IF LAST-OF(ttViperGrp.iGroupLabelSeq) THEN 
    ASSIGN cVfd = cVfd + e2ol 
                + "EndObject=Group" + eol
           cPrevGrpType = ttViperGrp.cGroupType
           iPrevGrpSeq  = ttViperGrp.iViperGrpSeq
           bPrevGrpHor  = ttViperGrp.bHorizontal
           .

END.

RETURN cVfd.   /* Function return value. */

END FUNCTION.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _FUNCTION initFonts C-Win 
FUNCTION initFonts RETURNS LOGICAL
  ( /* parameter-definitions */ ) :
/*------------------------------------------------------------------------------
  Purpose:  
    Notes:   Font1=Times New Roman, Size=10, 

------------------------------------------------------------------------------*/
DEF VAR cTemplate AS CHAR NO-UNDO.
DEF VAR cEntry    AS CHAR NO-UNDO.
DEF VAR ix        AS INT  NO-UNDO.
DEF VAR cFontNo   AS CHAR NO-UNDO.
DEF VAR cFontName AS CHAR NO-UNDO.
DEF VAR cList     AS CHAR NO-UNDO INIT "Default|0".

cTemplate = getReportTemplate().
cTemplate = SUBSTR(cTemplate,INDEX(cTemplate,"font1")).

DO WITH FRAME {&FRAME-NAME}.
  grpFont:DELIMITER = "|".
  fldFont:DELIMITER = "|".

  DO ix = 1 TO NUM-ENTRIES(cTemplate,"="):
    cEntry = TRIM(ENTRY(ix,cTemplate,"=")).
    cEntry = TRIM(ENTRY(NUM-ENTRIES(cEntry),cEntry)).
    IF cEntry BEGINS "font" THEN DO:
      cFontNo = SUBSTR(cEntry,5).
      cFontName = ENTRY(ix + 1,cTemplate,"=") + "=" + ENTRY(1,ENTRY(ix + 2,cTemplate,"=")).
      cList = cList + "|" + cFontNo + ": " + cFontName + "|" + cFontNo.
    END.
  END.
  grpFont:LIST-ITEM-PAIRS = cList.
  grpFont:SCREEN-VALUE = "0".
  fldFont:LIST-ITEM-PAIRS = cList.
  fldFont:SCREEN-VALUE = "0".
END.


RETURN YES.

END FUNCTION.

